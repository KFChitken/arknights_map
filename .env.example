# Copy to .env and fill in (read by both npm and Docker).
# Amap Web (JS API) key and security code for the China basemap. Leave empty to use OSM only.
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
# Amap web service key: place search for visitors from mainland China goes through the server
# (/api/geo), which spends at most AMAP_SEARCH_DAILY Amap searches a day. Empty: OpenStreetMap only.
AMAP_WEBSERVICE_KEY=
AMAP_SEARCH_DAILY=150
# 高德 map loads a month for the account (each visit from mainland China makes one); the site's
# checks email once a month when 80% is gone or the month's pace would use it up
AMAP_MAP_LOADS=1500000
# 腾讯位置服务 key (WebServiceAPI, limited to the site's domains) for typing suggestions to visitors
# from mainland China, asked by the browser. Empty: those suggestions come from OpenStreetMap.
# The same key draws Tencent's map (JavaScript API GL) for them when Amap's cannot load; empty: our own map then.
NEXT_PUBLIC_TENCENT_KEY=
# Which map visitors from mainland China start with: auto (or empty) is Amap's, but Tencent's for the rest of a
# Beijing month in which Amap's map loads ran out; amap, tencent or own (ours) holds that one whatever happens.
# Each still gives way to the next when it cannot load. Read at start: restart the site after changing it.
MAINLAND_MAP=
# MapLibre style for the OSM basemap, defaults to OpenFreeMap
NEXT_PUBLIC_OSM_STYLE=https://tiles.openfreemap.org/styles/liberty

# Database and mail. For local development run `docker compose up -d db mail`;
# the test inbox is at http://localhost:8025.
DATABASE_URL=postgres://roach:roach@localhost:5432/roach
SMTP_URL=smtp://localhost:1025
MAIL_FROM=舟P地图 <no-reply@example.com>
# Login emails the whole site may send in any 24 hours (default 90, under Resend's free 100 a day)
MAIL_DAILY_LIMIT=
# Mail services slow to take our mail just now, comma separated: their addresses get a note after a code is sent (empty: none)
MAIL_SLOW_DOMAINS=
# Port of the local test inbox to link from the sign-in screen; leave empty in production
DEV_MAILBOX_PORT=8025
# Sign-in emails (comma separated) that may open /admin to handle reports; they also get the checks' emails and digest
ADMIN_EMAILS=
# The Beijing hour (0-23) the site's checks send their daily digest from; 9 when empty
WATCH_DIGEST_HOUR=
# Show roaches that belong to nobody, drawn only on the map (0 or empty: none)
SHOW_BOTS=
# Small character pictures (fetched into operator-art/ by scripts/fetch-operator-art.mjs); off shows names only
OPERATOR_AVATARS=on
# Where links in emails point (defaults to https://zhoupmap.com in production, http://localhost:3000 otherwise)
SITE_URL=
# A long random string (e.g. `openssl rand -base64 32`) that signs sessions and login codes
AUTH_SECRET=
