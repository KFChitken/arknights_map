# Copy to .env and fill in (read by both npm and Docker).
# Amap Web (JS API) key and security code for the China basemap. Leave empty to use OSM only.
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
# MapLibre style for the OSM basemap, defaults to OpenFreeMap
NEXT_PUBLIC_OSM_STYLE=https://tiles.openfreemap.org/styles/liberty
