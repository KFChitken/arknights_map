# HTTPS certificates are fetched and renewed automatically.

# HTTP/1.1 and HTTP/2 only (2026-11-09): HTTP/3 runs over UDP, which networks in mainland China
# often slow down in the evening, and a browser does not leave a slow HTTP/3 for HTTPS over TCP.
{
	servers {
		protocols h1 h2
	}
}

zhoupmap.com {
	request_body {
		max_size 1MB
	}
	header {
		# HTTPS only, for two years, subdomains too, and on the browsers' built-in list (hstspreload.org)
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		-X-Powered-By
		# browsers that learned HTTP/3 here before forget it (take this out if HTTP/3 comes back)
		Alt-Svc "clear"
	}
	# the live event stream must reach the browser as it is written, and the map tiles and pictures come compressed already
	@compressible not path /api/events /tiles/* /operator-art/*
	encode @compressible zstd gzip
	# the characters' pictures (src/lib/server/operatorArt.ts), files named by their content, straight from the
	# server's folder: through the site's own process each cost it a whole request (2026-11-10: about 8% of its
	# CPU). Only those names. Switching the pictures off (OPERATOR_AVATARS) stops the pages asking for them;
	# to stop them being served at all, take the folder's files away too.
	# (and only a file that is there: a missing one goes on to the site, so its 404 is not kept for a year)
	@operatorArt {
		path_regexp ^/operator-art/[0-9a-f]{16}\.webp$
		file {
			root /srv
		}
	}
	handle @operatorArt {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# our own overseas map (src/lib/overseas.ts): the map file, fonts and icons, straight from the
	# server's folder in ranges as asked; a file never changes under its name, a new one gets a new name
	handle /tiles/* {
		root * /srv
		header Cache-Control "public, max-age=604800, immutable"
		# the map file (17.8 GB) goes out a piece at a time, as the map asks for it; a download of the
		# whole file, which would tie up the server's bandwidth, is refused
		@whole {
			path *.pmtiles
			method GET
			not header Range *
		}
		respond @whole "The map file is only served in ranges." 403
		file_server
	}
	handle {
		reverse_proxy web:3000
	}
}

www.zhoupmap.com {
	header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	redir https://zhoupmap.com{uri} permanent
}
